    {
        "id": "57d384d9b5c26943",
        "type": "template",
        "z": "2ab04c2dd50ec8c8",
        "name": "",
        "field": "payload",
        "fieldType": "msg",
        "format": "html",
        "syntax": "plain",
        "template": "<!DOCTYPE html>\n<html lang=\"es\">\n\n<head>\n    <meta charset=\"UTF-8\" />\n    <title>Datos de Sensores</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            background: #f0f8ff;\n            color: #333;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            height: 100vh;\n            margin: 0;\n        }\n\n        .container {\n            background: #ffffff;\n            padding: 2rem 3rem;\n            border-radius: 12px;\n            box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);\n            text-align: center;\n            width: 300px;\n        }\n\n        h1 {\n            margin-bottom: 1.5rem;\n            color: #007acc;\n        }\n\n        .sensor-data {\n            font-size: 1.2rem;\n            margin: 0.8rem 0;\n            padding: 0.5rem;\n            border-radius: 8px;\n            background: #e7f3ff;\n            border: 1px solid #a1c4fd;\n        }\n\n        .temp {\n            color: #e94e77;\n            font-weight: bold;\n        }\n\n        .hum {\n            color: #3498db;\n            font-weight: bold;\n        }\n    </style>\n</head>\n\n<body>\n    <div class=\"container\">\n        <h1>Datos de Sensores</h1>\n        <div class=\"sensor-data\">Temperatura: <span class=\"temp\">{{req.params.temp}}°C</span></div>\n        <div class=\"sensor-data\">Humedad: <span class=\"hum\">{{req.params.hum}}%</span></div>\n    </div>\n</body>\n\n</html>",
        "output": "str",
